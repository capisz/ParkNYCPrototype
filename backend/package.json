{
  "name": "nyc-parking-planner-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NYC Parking Planner advisory API and snapshot ingestion service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "ingest:meters": "tsx src/jobs/ingestMeters.ts",
    "ingest:geometry": "tsx src/jobs/ingestGeometry.ts",
    "ingest:signs": "tsx src/jobs/ingestSigns.ts",
    "ingest:facilities": "tsx src/jobs/ingestFacilities.ts",
    "ingest:rules": "tsx src/jobs/rebuildRules.ts",
    "ingest:all": "tsx src/jobs/ingestAll.ts",
    "test": "vitest run src"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
